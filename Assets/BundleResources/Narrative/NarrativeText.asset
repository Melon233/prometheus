  - key: story.demo.greet.opt.leave
    value: "\u6211\u8FD8\u6709\u522B\u7684\u4E8B\u3002"
  - key: story.demo.greet.help
    value: "\u597D\u5B69\u5B50\u3002\u8DEF\u4E0A\u5F53\u5FC3\uFF0C\u90A3\u8FB9\u7684\u98CE\u4E0D\u592A\u5BFB\u5E38\u3002"
  - key: story.demo.greet.leave
    value: "\u2026\u2026\u4E5F\u7F62\u3002\u7B49\u4F60\u6709\u7A7A\u4E86\uFF0C\u518D\u6765\u627E\u6211\u3002"
  - key: story.demo.report.1
    value: "\u9152\u74F6\u627E\u5230\u4E86\uFF1F\u592A\u597D\u4E86\uFF0C\u8C22\u8C22\u4F60\uFF0C\u65C5\u884C\u8005\u3002"
  - key: story.demo.report.2
    value: "\u8FD9\u70B9\u5FC3\u610F\u8BF7\u6536\u4E0B\uFF0C\u8DEF\u4E0A\u7528\u5F97\u7740\u3002"
  - key: quest.lost_bottle.title
