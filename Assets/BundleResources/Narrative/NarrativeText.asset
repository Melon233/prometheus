  entries:
  - key: actor.elder.name
    value: "\u8499\u5FB7\u957F\u8005"
  - key: story.demo.greet.1
    value: "\u8FDC\u9053\u800C\u6765\u7684\u65C5\u884C\u8005\uFF0C\u4F60\u7EC8\u4E8E\u5230\u4E86\u3002"
  - key: story.demo.greet.2
    value: "\u98CE\u8D77\u5730\u90A3\u8FB9\u51FA\u4E86\u70B9\u4E71\u5B50\u2026\u2026\u6211\u8FD9\u628A\u8001\u9AA8\u5934\u662F\u8D70\u4E0D\u52A8\u4E86\u3002"
  - key: story.demo.greet.opt.help
